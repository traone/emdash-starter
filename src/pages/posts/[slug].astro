---
import { getEmDashEntry, getSeoMeta, decodeSlug, getSiteSettings } from "emdash";
import { Image, PortableText, WidgetArea } from "emdash/ui";
import Base from "../../layouts/Base.astro";
import { resolveStarterSiteIdentity } from "../../utils/site-identity";

const slug = decodeSlug(Astro.params.slug);

if (!slug) {
	return Astro.redirect("/404");
}

const { entry: post, cacheHint } = await getEmDashEntry("posts", slug);

if (!post) {
	return Astro.redirect("/404");
}

if (Astro.cache?.enabled) Astro.cache.set(cacheHint);
const { siteTitle } = resolveStarterSiteIdentity(await getSiteSettings());

// SEO meta from content fields
const seo = getSeoMeta(post, {
	siteTitle,
	siteUrl: Astro.url.origin,
	path: `/posts/${slug}`,
});

// Taxonomy terms are already hydrated onto the entry by getEmDashEntry.
const tags = post.data.terms?.tag ?? [];
const categories = post.data.terms?.category ?? [];
---

<Base
	title={seo.title}
	pageTitle={seo.ogTitle}
	description={seo.description}
	canonical={seo.canonical}
	image={seo.ogImage}
	content={{ collection: "posts", id: post.data.id, slug }}
>
	<article>
		{
			post.data.featured_image && (
				<div {...post.edit.featured_image}>
					<Image image={post.data.featured_image} class="mb-6 w-full rounded-sm object-cover" />
				</div>
			)
		}

		<h1 {...post.edit.title} class="text-3xl font-semibold tracking-tight">
			{post.data.title}
		</h1>

		{
			post.data.publishedAt && (
				<time datetime={post.data.publishedAt.toISOString()} class="mt-2 block text-sm text-neutral-500">
					{post.data.publishedAt.toLocaleDateString("en-US", {
						year: "numeric",
						month: "long",
						day: "numeric",
					})}
				</time>
			)
		}

		{
			categories.length > 0 && (
				<div class="mt-3 flex flex-wrap gap-x-3 gap-y-1 text-sm">
					{categories.map((c) => (
						<a href={`/category/${c.slug}`} class="text-neutral-600 dark:text-neutral-400">
							{c.label}
						</a>
					))}
				</div>
			)
		}

		<div class="prose prose-neutral mt-8 max-w-none dark:prose-invert">
			<PortableText value={post.data.content} />
		</div>

		{
			tags.length > 0 && (
				<div class="mt-8 flex flex-wrap gap-x-3 gap-y-1 border-t border-neutral-200 pt-6 text-sm text-neutral-500 dark:border-neutral-800">
					{tags.map((t) => (
						<a href={`/tag/${t.slug}`} class="hover:text-neutral-900 dark:hover:text-neutral-100">
							#{t.label}
						</a>
					))}
				</div>
			)
		}
	</article>

	<aside class="mt-10 border-t border-neutral-200 pt-6 dark:border-neutral-800">
		<WidgetArea name="sidebar" />
	</aside>
</Base>
